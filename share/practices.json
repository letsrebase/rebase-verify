{
  "notes": [
    "Commands are read as recorded by the coding agent, which caps each at 240 characters, so a check at the end of a long chained command can be missed.",
    "Paths are compared lower-cased, with a backslash read as a forward slash.",
    "Leading environment assignments and the npx, uv run, python -m and pnpm exec wrappers are skipped before a command is matched."
  ],
  "practices": [
    {
      "definition": "After the last file edit before a git commit, a check ran in the session: tests, a linter, a type check or a build.",
      "denominator": "Sessions with a commit.",
      "id": "checks_before_commit",
      "method": "code"
    },
    {
      "definition": "Both a source file and a test file were edited in the session.",
      "denominator": "Sessions that edited a source file.",
      "id": "tests_with_changes",
      "method": "code"
    },
    {
      "definition": "A command failed, files were edited, and then the same command succeeded in the session.",
      "denominator": "Sessions where a command failed.",
      "id": "failure_reproduced_before_fix",
      "method": "code"
    },
    {
      "definition": "A planning step came before the first file edit in the session: plan mode, a task list, or writing a plan or spec file.",
      "denominator": "Sessions with an edit.",
      "id": "plan_before_edit",
      "method": "code"
    },
    {
      "definition": "Before a commit or a pull request, the diff appeared in the session (git diff, git show or gh pr diff), whoever asked for it; the session cannot show whether anyone read it.",
      "denominator": "Sessions with a commit or a pull request.",
      "id": "reviews_changes",
      "method": "code"
    },
    {
      "definition": "A design document (an ADR, RFC, spec or design file, by path) was written or edited in the session.",
      "denominator": "Sessions with an edit.",
      "id": "design_documents",
      "method": "code"
    },
    {
      "definition": "A dependency audit or a security scanner ran in the session.",
      "denominator": "Sessions with an edit.",
      "id": "security_checks",
      "method": "code"
    }
  ],
  "rubric": "rebase-practices/v1",
  "rules": {
    "checks": [
      "^(?:py\\.test|pytest)(?=\\s|$)",
      "^ruff\\s+check(?=\\s|$)",
      "^(?:mypy|pyright|flake8|pylint)(?=\\s|$)",
      "^go\\s+(?:test|vet|build)(?=\\s|$)",
      "^golangci-lint\\s+run(?=\\s|$)",
      "^cargo\\s+(?:test|clippy|check|build|nextest)(?=\\s|$)",
      "^(?:mvn|\\.\\/mvnw)\\s+(?:\\S+\\s+)*?(?:test|verify|package)(?=\\s|$)",
      "^(?:gradle|\\.\\/gradlew)\\s+(?:\\S+\\s+)*?(?:test|check|build)(?=\\s|$)",
      "^dotnet\\s+(?:test|build)(?=\\s|$)",
      "^(?:\\.\\/)?(?:vendor\\/bin\\/)?(?:phpunit|phpstan|pest)(?=\\s|$)",
      "^(?:bundle\\s+exec\\s+)?(?:rspec|rubocop)(?=\\s|$)",
      "^tsc(?=\\s|$)",
      "^(?:eslint|biome\\s+(?:check|lint|ci))(?=\\s|$)",
      "^vitest(?=\\s|$)",
      "^jest(?=\\s|$)",
      "^(?:playwright|cypress)\\s+(?:test|run)(?=\\s|$)",
      "^node\\s+(?:\\S+\\s+)*?--test(?=\\s|$)",
      "^(?:npm|pnpm|yarn|bun)\\s+(?:run\\s+)?(?:test|tests|lint|typecheck|type-check|check|build|ci)(?=\\s|$)",
      "^make\\s+(?:test|tests|check|lint|build|ci)(?=\\s|$)"
    ],
    "designPaths": [
      "(?:^|\\/)adr\\/",
      "(?:^|\\/)(?:rfcs\\/|docs\\/rfc\\/)",
      "(?:^|\\/)docs\\/design\\/",
      "(?:^|\\/)specs\\/",
      "(?:^|\\/)(?:adr-[^/]*|[^/]*-adr\\.md)$",
      "(?:^|\\/)rfc[^/]*$",
      "(?:^|\\/)(?:[^/]*-design|design)\\.md$",
      "(?:^|\\/)[^/]*-spec\\.md$"
    ],
    "diff": [
      "^git(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--no-pager))*\\s+diff(?=\\s|$)(?!.*\\s--(?:stat|numstat|shortstat|name-only|name-status)\\b)",
      "^git(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--no-pager))*\\s+show(?=\\s|$)(?!.*\\s--(?:stat|numstat|shortstat|name-only|name-status)\\b)(?!.*\\s[^\\s-]\\S*:\\S)",
      "^gh\\s+pr\\s+diff(?=\\s|$)"
    ],
    "planPaths": [
      "(?:^|\\/)plans\\/",
      "(?:^|\\/)(?:[^/]*-plan|plan)\\.md$",
      "(?:^|\\/)specs\\/",
      "(?:^|\\/)[^/]*-spec\\.md$"
    ],
    "security": [
      "^(?:npm|pnpm|yarn|bun)\\s+audit(?=\\s|$)",
      "^(?:pip-audit|safety\\s+check|bandit)(?=\\s|$)",
      "^cargo\\s+(?:audit|deny)(?=\\s|$)",
      "^(?:trivy|semgrep|gitleaks|trufflehog|snyk|grype|osv-scanner|brakeman|bundler-audit|govulncheck)(?=\\s|$)"
    ],
    "sourceExclusions": [
      "\\.config\\.[^/]+$",
      "\\.d\\.[cm]?ts$",
      "(?:^|\\/)conftest\\.py$",
      "(?:^|\\/)setup\\.py$",
      "(?:^|\\/)docs\\/"
    ],
    "testPaths": [
      "(?:^|\\/)(?:tests?|__tests__|spec)\\/",
      "\\.(?:test|spec)\\.[^/]+$",
      "_test\\.[^/]+$",
      "(?:^|\\/)test_[^/]*\\.py$"
    ]
  }
}
